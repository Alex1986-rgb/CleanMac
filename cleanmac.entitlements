<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements для hardened runtime. Обязательны для PyInstaller/Python-бандла:
  интерпретатор Python грузит немодульные dylib и использует JIT-подобные приёмы —
  без этих прав нотаризованное приложение упадёт при запуске (или не пройдёт notarize).
  Держим минимальный набор, только необходимое.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
